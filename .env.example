# Copiá este archivo como .env  y completá los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# --- Clave de acceso al panel ---
# La contraseña única para entrar a la aplicación.
# Si la dejás vacía, el panel queda SIN protección (solo para pruebas locales).
APP_PASSWORD=

# --- Clave para firmar las sesiones (cookies) ---
# Poné cualquier texto largo y aleatorio. Ejemplo: pegá 40 caracteres al azar.
SECRET_KEY=cambia-esto-por-un-texto-largo-y-aleatorio

# --- API Key de Google Gemini (gratis) ---
# Cómo obtenerla: ver GUIA.md, sección "Cómo generar tu clave de Gemini".
GEMINI_API_KEY=

# Modelo de Gemini a usar (dejalo así salvo que sepas lo que hacés).
GEMINI_MODEL=gemini-2.0-flash

# --- Opcionales (podés dejarlos como están) ---
# Puerto local donde corre la app.
PORT=8000
# Tamaño máximo de archivo que se puede subir, en MB.
MAX_CONTENT_MB=25
