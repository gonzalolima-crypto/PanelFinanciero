# Copiá este archivo como .env  y completá los valores.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

# --- Clave de acceso al panel ---
# La contraseña única para entrar a la aplicación.
# Si la dejás vacía, el panel queda SIN protección (solo para pruebas locales).
APP_PASSWORD=

# --- Clave para firmar las sesiones (cookies) ---
# Poné cualquier texto largo y aleatorio. Ejemplo: pegá 40 caracteres al azar.
SECRET_KEY=cambia-esto-por-un-texto-largo-y-aleatorio

# --- API Key de Groq (gratis) ---
# Cómo obtenerla: ver GUIA.md, sección "Cómo generar tu clave de Groq".
GROQ_API_KEY=

# Modelos de Groq (dejalos así salvo que sepas lo que hacés).
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Modelo con visión para fotos de tickets. Dejar vacío si tu cuenta de Groq
# no tiene uno habilitado (en ese caso los comprobantes se aceptan sólo en PDF).
GROQ_VISION_MODEL=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# --- Base de datos ---
# Vacío = usa el archivo local data/panel.db (SQLite). Es lo normal en tu compu.
# En producción (Render) se completa con la cadena de conexión de Neon:
#   postgresql://usuario:clave@host.neon.tech/basedatos?sslmode=require
DATABASE_URL=

# --- Opcionales (podés dejarlos como están) ---
# Puerto local donde corre la app.
PORT=8000
# Tamaño máximo de archivo que se puede subir, en MB.
MAX_CONTENT_MB=25
# Máximo de páginas de un PDF de resumen que se procesan.
PDF_MAX_PAGES=8
